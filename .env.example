# TRACE Configuration Template
# NOTE: This file contains non-secret placeholder values only.
# Copy this file to .env and adjust values for your local environment.
# Never commit real private keys, secrets, or live credentials to version control.

# --- Blockchain (Hardhat Local Node) ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
TRACE_ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Backend Configuration (FastAPI) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_PATH=backend/data/trace.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo Configuration ---
# Standard fixed conversion rate for demonstration: 1 ETH = 2000 USD (in cents: 200000)
DEMO_ETH_TO_USD_RATE=2000
DEMO_SIMULATED_CHAINS_ENABLED=true

# --- Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_RPC_URL=http://127.0.0.1:8545
